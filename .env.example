# Servidor: access token do MercadoPago (nunca prefixar com NEXT_PUBLIC_, nunca commitar o valor real)
MP_ACCESS_TOKEN=

# Cliente: public key do MercadoPago usada pelo SDK JS no navegador
NEXT_PUBLIC_MP_PUBLIC_KEY=

# URL pública base da aplicação (ex.: https://seu-dominio), usada em back_urls/notification_url
NEXT_PUBLIC_URL=

# Conexão com o Postgres (usada por prisma.config.ts / DATABASE_URL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/psi_maria_cristina"

# Login da psicóloga (seed do Prisma). Gerar o hash com:
# node -e "require('bcrypt').hash('SUA_SENHA',10).then(console.log)"
PSICOLOGA_EMAIL=
PSICOLOGA_SENHA_HASH=

# Segredo para validar o header x-signature dos webhooks do MercadoPago
MP_WEBHOOK_SECRET=

# Segredo de assinatura do cookie de sessão (JWT)
JWT_SECRET=

# Documentos clínicos (dado de saúde). Pasta PRIVADA no servidor, FORA de /public e de qualquer
# diretório servido como estático; o único acesso é GET /api/documentos/[id]/download (autenticado).
# Em produção: caminho absoluto, permissões restritas ao usuário do app (chmod 700) e incluída no backup.
DOCUMENTOS_DIR=./documentos-privados
# Tamanho máximo por arquivo, em MB (padrão 15)
DOCUMENTOS_MAX_MB=15

# ---------------------------------------------------------------- Fase 5b · gateways de pagamento
# TODAS as credenciais abaixo são SERVER-ONLY (nunca NEXT_PUBLIC_*, nunca no cliente).
# Se a env de um gateway faltar, a geração de cobrança por ele FALHA explicitamente (sem fallback).

# MercadoPago — Checkout Pro (preference). Sandbox: credenciais de TESTE.
# MP_ACCESS_TOKEN já é usado pelas rotas legadas; o webhook exige o secret abaixo (painel do MP →
# "Suas integrações" → Webhooks → chave secreta), usado no HMAC de x-signature.
MP_WEBHOOK_SECRET=

# Asaas — link de pagamento hospedado. Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token que o Asaas envia no header asaas-access-token de cada webhook (definido por você no painel)
ASAAS_WEBHOOK_TOKEN=

# NEXT_PUBLIC_URL é obrigatória para back_urls/notification_url — sem ela a geração de cobrança
# falha (nada de fallback localhost; ver M12 no SEGURANCA-PRE-PRODUCAO.md).

# ---------------------------------------------------------------- Fase 6 · e-mail (Resend)
# Chave de API do Resend. SERVER-ONLY (nunca NEXT_PUBLIC_*, nunca no cliente, nunca em log).
RESEND_API_KEY=

# Remetente usado em todos os e-mails, no formato "Nome <email@dominio>".
# Em dev, o remetente é onboarding@resend.dev e o sandbox do Resend só entrega para o
# e-mail da própria conta cadastrada no Resend. Em produção é exigido domínio verificado
# no Resend (item de deploy).
EMAIL_REMETENTE="Maria Cristina · Psicóloga <onboarding@resend.dev>"
