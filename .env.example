# Servidor: access token do MercadoPago (nunca prefixar com NEXT_PUBLIC_, nunca commitar o valor real)
MP_ACCESS_TOKEN=

# Cliente: public key do MercadoPago usada pelo SDK JS no navegador
NEXT_PUBLIC_MP_PUBLIC_KEY=

# URL pública base da aplicação (ex.: https://seu-dominio), usada em back_urls/notification_url
NEXT_PUBLIC_URL=

# Conexão com o Postgres (usada por prisma.config.ts / DATABASE_URL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/psi_maria_cristina"

# Login da psicóloga (seed do Prisma). Gerar o hash com:
# node -e "require('bcrypt').hash('SUA_SENHA',10).then(console.log)"
PSICOLOGA_EMAIL=
PSICOLOGA_SENHA_HASH=

# Segredo para validar o header x-signature dos webhooks do MercadoPago
MP_WEBHOOK_SECRET=

# Segredo de assinatura do cookie de sessão (JWT)
JWT_SECRET=

# Documentos clínicos (dado de saúde). Pasta PRIVADA no servidor, FORA de /public e de qualquer
# diretório servido como estático; o único acesso é GET /api/documentos/[id]/download (autenticado).
# Em produção: caminho absoluto, permissões restritas ao usuário do app (chmod 700) e incluída no backup.
DOCUMENTOS_DIR=./documentos-privados
# Tamanho máximo por arquivo, em MB (padrão 15)
DOCUMENTOS_MAX_MB=15
